{
  "name": "wema-kake",
  "version": "0.0.0",
  "private": true,
  "description": "付箋ボードライブラリ wema を使った Wiki",
  "license": "ISC",
  "type": "module",
  "scripts": {
    "dev": "npm run build && wrangler dev",
    "build": "vite build",
    "deploy": "npm run build && node scripts/deploy.mjs",
    "types": "wrangler types --strict-vars=false",
    "lint": "npm run types && tsc -p tsconfig.json && tsc -p tsconfig.web.json && tsc -p tsconfig.node.json",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kan/wema-kake.git"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.1",
    "@kanf/wema": "^0.11.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "agents": "^0.26.0",
    "hono": "^4.13.12",
    "jose": "^6.2.12",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.3.6",
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.147.0"
  }
}
