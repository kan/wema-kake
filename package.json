{
  "name": "wema-kake",
  "version": "0.0.0",
  "private": true,
  "description": "付箋ボードライブラリ wema を使った Wiki",
  "license": "ISC",
  "type": "module",
  "scripts": {
    "dev": "npm run build && wrangler dev",
    "dev:roji": "npm run build && roji run wema-kake -- wrangler dev --port {port} --host {host} --upstream-protocol https",
    "build": "vite build",
    "deploy": "npm run build && node scripts/deploy.mjs",
    "types": "wrangler types --strict-vars=false",
    "lint": "npm run types && tsc -p tsconfig.json && tsc -p tsconfig.web.json && tsc -p tsconfig.node.json",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kan/wema-kake.git"
  },
  "dependencies": {
    "@kanf/wema": "^0.16.0",
    "@modelcontextprotocol/server": "^2.3.1",
    "agents": "^0.28.0",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.0",
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  }
}
