{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wema-kake",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist/web",
    // /p/<slug> などアセットに一致しないパスは index.html を返す
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*", "/img/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "PAGE", "class_name": "PageDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PageDO"] }],
  "d1_databases": [{ "binding": "DB", "database_name": "wema-kake" }]
}
