{
  "$schema": "node_modules/wrangler/config-schema.json",
  // このファイルは、このリポジトリの中の利用側（dev/）を動かすためのもの。ローカル開発とテストに
  // 使い、デプロイはしない。利用側の設定の正は template/wrangler.jsonc で、**バインディングや
  // assets を変えたら、あちらにも同じ変更を入れること**（AGENTS.md の「パッケージの構成」）
  "name": "wema-kake",
  "main": "dev/index.ts",
  "compatibility_date": "2026-10-01",
  // プレビュー用の URL（<version>-<name>.….workers.dev）は出さない。Access のアプリケーションは
  // 本番のホスト名にしか掛けないので、保護の外に同じ Worker の入口を作らない
  "preview_urls": false,
  "assets": {
    "binding": "ASSETS",
    // 利用側は node_modules/@kanf/wema-kake/dist/web を指す。ここでは、このリポジトリのビルドの出力
    "directory": "./dist/web",
    // /p/<slug> などアセットに一致しないパスは index.html を返す
    "not_found_handling": "single-page-application",
    // すべてのリクエストを Worker が先に受ける。API に当たらないものは、Worker が ASSETS から返す
    // （src/worker/assets.ts）。パスの一覧をパッケージが持つので、API のパスを足しても、利用側の
    // 設定は変わらない
    "run_worker_first": true
  },
  "vars": {
    // Cloudflare Access の設定。両方が空のままだと /api、/ws、/mcp は 500 を返す（ローカル開発は .dev.vars.example を参照）
    // 例: "https://<team>.cloudflareaccess.com"
    "ACCESS_TEAM_DOMAIN": "",
    // Access アプリケーションの AUD タグ
    "ACCESS_AUD": "",
    // このサイトのオリジン（例: "https://wiki.example.com"）。付箋内の絶対 URL のリンクを
    // ページ間リンクとして拾うのに使う。空のときは相対 URL（/p/<slug>）だけを拾う
    "SITE_ORIGIN": ""
  },
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "wema-kake-images" }],
  "durable_objects": {
    "bindings": [{ "name": "PAGE", "class_name": "PageDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PageDO"] }],
  "d1_databases": [{ "binding": "DB", "database_name": "wema-kake" }]
}
