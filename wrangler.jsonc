{
  "$schema": "node_modules/wrangler/config-schema.json",
  // このファイルは、ローカル開発とテストに使う。デプロイ先ごとの値（Worker の名前、D1 と KV の ID、
  // Access の値、SITE_ORIGIN）は、ここに書かない。このファイルを wrangler.deploy.jsonc（git には
  // 入れない）へコピーして書き、`npm run deploy` はそちらを使う（AGENTS.md の「デプロイ」）
  "name": "wema-kake",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  // プレビュー用の URL（<version>-<name>.….workers.dev）は出さない。Access のアプリケーションは
  // 本番のホスト名にしか掛けないので、保護の外に同じ Worker の入口を作らない
  "preview_urls": false,
  "assets": {
    "directory": "./dist/web",
    // /p/<slug> などアセットに一致しないパスは index.html を返す
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/ws/*",
      "/img/*",
      // MCP と、その OAuth 用のパス。Access の保護対象から外しておくこと（AGENTS.md の「認証」）
      "/mcp",
      "/authorize",
      "/callback",
      "/token",
      "/register",
      "/.well-known/*"
    ]
  },
  // MCP の OAuth（クライアントの登録、認可コード、トークン）の保存先
  "kv_namespaces": [{ "binding": "OAUTH_KV" }],
  "vars": {
    // Cloudflare Access の設定。両方が空のままだと /api と /ws は 500 を返す（ローカル開発は .dev.vars.example を参照）
    // 例: "https://<team>.cloudflareaccess.com"
    "ACCESS_TEAM_DOMAIN": "",
    // Access アプリケーションの AUD タグ
    "ACCESS_AUD": "",
    // このサイトのオリジン（例: "https://wiki.example.com"）。付箋内の絶対 URL のリンクを
    // ページ間リンクとして拾うのに使う。空のときは相対 URL（/p/<slug>）だけを拾う
    "SITE_ORIGIN": ""
  },
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "wema-kake-images" }],
  "durable_objects": {
    "bindings": [{ "name": "PAGE", "class_name": "PageDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PageDO"] }],
  "d1_databases": [{ "binding": "DB", "database_name": "wema-kake" }]
}
